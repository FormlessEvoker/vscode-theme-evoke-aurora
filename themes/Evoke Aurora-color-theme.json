  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "fontStyle": "italic", "foreground": "#6B7189" }
    },
    {
      "name": "Keywords and control flow",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#C9DFEE" }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.parameter"],
      "settings": { "foreground": "#8FC0F5" }
    },
    {
      "name": "Strings and symbols",
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#62FDC3" }
    },
    {
      "name": "Escapes, interpolation, and regular expressions",
      "scope": ["constant.character.escape", "string.regexp", "punctuation.section.embedded", "keyword.other.substitution"],
      "settings": { "foreground": "#8FC0F5" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": { "foreground": "#FCE79E" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "fontStyle": "bold", "foreground": "#9B7BFF" }
    },
    {
      "name": "C primitive types",
      "scope": ["storage.type.built-in.primitive.c"],
      "settings": { "fontStyle": "bold", "foreground": "#9B7BFF" }
    },
    {
      "name": "C preprocessor macro names",
      "scope": ["entity.name.function.preprocessor.c"],
      "settings": { "foreground": "#58B982" }
    },
    {
      "name": "Modules and namespaces",
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": { "fontStyle": "bold", "foreground": "#469AF9" }
    },
    {
      "name": "Interfaces",
      "scope": ["entity.name.interface"],
      "settings": { "fontStyle": "bold", "foreground": "#B99CFF" }
    },
    {
      "name": "Import paths",
      "scope": ["meta.import string"],
      "settings": { "foreground": "#469AF9" }
    },
    {
      "name": "Enum members",
      "scope": ["variable.other.enummember", "constant.other.enum"],
      "settings": { "foreground": "#58B982" }
    },
    {
      "name": "Function and method declarations",
      "scope": ["entity.name.function", "entity.name.method", "entity.name.constructor"],
      "settings": { "fontStyle": "bold", "foreground": "#84B5F2" }
    },
    {
      "name": "Function and method calls",
      "scope": ["meta.function-call", "variable.function", "support.function"],
      "settings": { "foreground": "#DCE8FF" }
    },
    {
      "name": "Properties and fields stay quiet",
      "scope": ["variable.other.property", "variable.object.property", "support.type.property-name"],
      "settings": { "foreground": "#DCE8FF" }
    },
    {
      "name": "Tags, attributes, and decorators",
      "scope": ["entity.name.tag", "entity.other.attribute-name", "meta.tag", "meta.annotation", "tag.decorator"],
      "settings": { "foreground": "#DF9DFC" }
    },
    {
      "name": "Grouping punctuation",
      "scope": ["punctuation"],
      "settings": { "foreground": "#DCE8FF" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "meta.operator"],
      "settings": { "foreground": "#8FC0F5" }
    },
    {
      "name": "Structural block delimiters",
      "scope": ["punctuation.definition.block.js", "punctuation.section.block.begin", "punctuation.section.block.end"],
      "settings": { "foreground": "#84B5F2" }
    },
    {
      "name": "String delimiters",
      "scope": ["punctuation.definition.string", "punctuation.definition.string.begin", "punctuation.definition.string.end"],
      "settings": { "foreground": "#62FDC3" }
    },
    {
      "name": "Elixir atoms",
      "scope": ["constant.language.symbol.elixir", "punctuation.definition.constant.elixir"],
      "settings": { "foreground": "#58B982" }
    },
    {
      "name": "JSON property names",
      "scope": ["support.type.property-name.json", "meta.object-literal.key"],
      "settings": { "fontStyle": "", "foreground": "#DCE8FF" }
    },
    {
      "name": "CSS properties",
      "scope": ["source.css support.type.property-name", "source.scss support.type.property-name", "source.sass support.type.property-name", "source.less support.type.property-name"],
      "settings": { "foreground": "#DCE8FF" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": { "fontStyle": "bold", "foreground": "#CFFFE7" }
    },
    {
      "name": "Markup emphasis",
      "scope": ["markup.italic", "markup.bold"],
      "settings": { "foreground": "#DF9DFC" }
    },
    {
      "name": "Invalid syntax",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FA746F" }
    }
  ],
  "semanticTokenColors": {
    "comment": "#6B7189",
    "keyword": "#C9DFEE",
    "string": "#62FDC3",
    "number": "#FCE79E",
    "regexp": "#8FC0F5",
    "operator": "#8FC0F5",
    "type": { "foreground": "#9B7BFF", "bold": true },
    "class": { "foreground": "#9B7BFF", "bold": true },
    "interface": { "foreground": "#B99CFF", "bold": true },
    "enum": { "foreground": "#9B7BFF", "bold": true },
    "enumMember": "#58B982",
    "namespace": { "foreground": "#469AF9", "bold": true },
    "parameter": "#8FC0F5",
    "property": { "foreground": "#DCE8FF", "bold": false },
    "function": "#DCE8FF",
    "method": "#DCE8FF",
    "function.declaration": { "foreground": "#84B5F2", "bold": true },
    "method.declaration": { "foreground": "#84B5F2", "bold": true },
    "decorator": "#FCE79E",
    "macro": "#FA746F",
    "variable.readonly": "#8FC0F5",
    "variable.defaultLibrary": "#84B5F2"
  }
}
